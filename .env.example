# Copy to .env to override the defaults used by docker-compose.yml.

# PostgreSQL database name
DB_NAME=portfolio
# PostgreSQL user (also used by the backend)
DB_USERNAME=portfolio
# PostgreSQL password (also used by the backend)
DB_PASSWORD=portfolio
# Host port for PostgreSQL; change it if 5432 is already taken
DB_PORT=5432
# Host port where the app is served (nginx: frontend + /api)
APP_PORT=8080

# Admin area (local only; set real values in the Render dashboard, never in the repo)
# Signs admin tokens: base64 of at least 32 random bytes. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW5vdC1mb3ItcHJvZCEh
# The single admin: username 3-50 characters, password at least 12 characters (max 72 bytes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-password
